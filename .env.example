# Copy to .env and fill in. All settings are optional unless marked.

# --- Server (required for monitoring and server-side detection) ---
SERVER_HOST=192.168.1.8
SERVER_PORT=8000
# Must match ROBOT_KEY in the server's server/.env
ROBOT_KEY=
# Name shown in the dashboard; leave out to use the Pi's hostname
ROBOT_ID=pest-robot-1

# --- Detection ---
# auto (robot model if possible, else server) | local | server
DETECTION_MODE=auto
MODEL_BACKEND=tflite
MODEL_FILENAME=pest_model.tflite
MODEL_DOWNLOAD_URL=
ANNOTATIONS_DOWNLOAD_URL=
# CPU threads for the local model (Pi 3B+: 4)
MODEL_NUM_THREADS=4

# --- Camera and streaming ---
# picamera2 (Pi camera), opencv / v4l2 (USB webcam), synthetic (test frames, no camera)
CAMERA_BACKENDS=picamera2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
# Frames per second sent to the server
STREAM_FPS=5
JPEG_QUALITY=75

# --- Hardware ---
ARDUINO_ENABLED=true
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUDRATE=9600

# --- Wi-Fi setup hotspot (used when no known network is available) ---
WIFI_MANAGEMENT_ENABLED=true
HOTSPOT_SSID=pest-robot-setup
# At least 8 characters; anyone who joins the hotspot can send the robot Wi-Fi settings
HOTSPOT_PASSWORD=

LOG_LEVEL=INFO
